[{data_source:"Directus",id:"7b4058e4-b08a-4ffe-b8d6-af7d01212f51",map_service_layer_name:"umum:Persil",map_service_url:"/bhumigs/umum",map_service_vendor:"Geoserver",name:"Bidang Tanah",opacity:1,type:"2D",visibility:"visible",description:"IGT bidang tanah terdaftar yang diklasifikasikan berdasarkan tema jenis hak, status pendaftaran, dan penggunaan. Pilihan tema dapat diubah pada panel legenda yang terletak di sisi kiri peta. Fitur bidang tanah yang dipilih akan menampilkan informasi berupa tipe hak atas tanah, nomor induk bidang (NIB), dan luas tanah yang tertulis di sertipikat tanah.",thumbnail_image:"0430daa1-00be-46ed-82dd-e57f2a9f041c"}]